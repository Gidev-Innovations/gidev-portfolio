{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static site from React Router (ssr: false). Build output lives in build/client.
  // Cloudflare Builds runs: npm run build && npx wrangler versions upload
  "name": "gidev-portfolio",
  "compatibility_date": "2026-08-25",
  "assets": {
    "directory": "./build/client",
    // Serves the generated 404.html for unknown paths (see scripts/generate-seo-files.mjs).
    "not_found_handling": "404-page",
    // Canonicals and the sitemap use /about, not /about/. The default
    // (auto-trailing-slash) 307-redirects every page to the slash form.
    "html_handling": "drop-trailing-slash"
  }
}
